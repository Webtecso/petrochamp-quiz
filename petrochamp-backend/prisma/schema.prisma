generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SyncMeta {
  id           String    @id @default("singleton")
  lastSyncedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

model Team {
  id              String              @id @default(cuid())
  name            String
  institution     String
  category        String
  logoUrl         String?
  group           String?
  bracketPosition Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  duplasA         PresentationDupla[] @relation("DuplaTeamA")
  duplasB         PresentationDupla[] @relation("DuplaTeamB")
  scores          PresentationScore[]
}

model Question {
  id             String    @id @default(cuid())
  championship   String
  text           String
  imageUrl       String?
  optionA        String?
  optionB        String?
  optionC        String?
  optionD        String?
  optionE        String?
  optionF        String?
  optionG        String?
  optionH        String?
  correctIndexes String?
  points         Int
  phase          Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}

model TiebreakQuestion {
  id             String    @id @default(cuid())
  championship   String
  text           String
  imageUrl       String?
  optionA        String?
  optionB        String?
  optionC        String?
  optionD        String?
  optionE        String?
  optionF        String?
  optionG        String?
  optionH        String?
  correctIndexes String?
  points         Int
  phase          Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}

model Setting {
  key       String    @id
  value     String
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Phase {
  id                    String                    @id @default(cuid())
  championship          String
  order                 Int
  label                 String
  type                  String                    @default("quiz")
  useQuestions          Boolean                   @default(true)
  useJudges             Boolean                   @default(false)
  maxQuestions          Int?
  questionsPerTeam      Int?
  avoidRepeatQuestions  Boolean                   @default(true)
  useInitialScores      Boolean                   @default(false)
  initialScoreMaxPoints Int?
  presentationMinutes   Int?
  presentationWeight    Int?                      @default(50)
  quizWeight            Int?                      @default(50)
  noElimination         Boolean                   @default(false)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  deletedAt             DateTime?

  duplas                PresentationDupla[]
  criteria              PresentationCriteria[]
  jurorAuthorizations   PhaseJurorAuthorization[]
}

model PresentationDupla {
  id        String    @id @default(cuid())
  phaseId   String
  phase     Phase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  order     Int
  themeA    String
  themeB    String?
  teamAId   String
  teamA     Team      @relation("DuplaTeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamBId   String?
  teamB     Team?     @relation("DuplaTeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([phaseId, teamAId])
}

model PresentationCriteria {
  id        String              @id @default(cuid())
  phaseId   String
  phase     Phase               @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  label     String
  maxPoints Int
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?

  scores    PresentationScore[]
}

model PresentationScore {
  id         String               @id @default(cuid())
  criteriaId String
  criteria   PresentationCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  jurorId    String
  juror      Juror                @relation(fields: [jurorId], references: [id], onDelete: Cascade)
  teamId     String
  team       Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  score      Int
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  deletedAt  DateTime?

  @@unique([criteriaId, jurorId, teamId])
}

model LiveSession {
  id        String   @id @default("singleton")
  data      String
  updatedAt DateTime @updatedAt
}

model BracketMatch {
  id           String    @id @default(cuid())
  championship String
  round        Int
  slot         Int
  groupName    String?
  teamAId      String?
  teamBId      String?
  winnerId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([championship, round, slot])
}

model SuspensePhrase {
  id        String    @id @default(cuid())
  text      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model TiebreakMatch {
  id           String    @id @default(cuid())
  championship String
  phase        Int
  teamAId      String
  teamBId      String
  teamAScore   Int       @default(0)
  teamBScore   Int       @default(0)
  winnerId     String?
  resolved     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model Partner {
  id        String    @id @default(cuid())
  name      String
  logoUrl   String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model MatchHistory {
  id              String    @id @default(cuid())
  championship    String
  editionName     String?
  phase           Int
  phaseLabel      String
  teamAId         String
  teamAName       String
  teamBId         String
  teamBName       String
  teamAScore      Int
  teamBScore      Int
  winnerId        String?
  winnerName      String?
  wasTiebreak     Boolean   @default(false)
  deviceMode      String?
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

model RepescagemConfig {
  id                    String    @id @default(cuid())
  championship          String
  phase                 Int
  maxRepescados         Int
  votingDurationSeconds Int       @default(60)
  votingOpen            Boolean   @default(false)
  started               Boolean   @default(false)
  startedAt             DateTime?
  closedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
}

model RepescagemVote {
  id         String    @id @default(cuid())
  configId   String
  teamId     String
  voterToken String
  voterIp    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([configId, voterToken])
}

model ChampionshipHistory {
  id               String    @id @default(cuid())
  championship     String
  editionName      String
  championTeamId   String?
  championTeamName String?
  finalRankingJson String
  matchesJson      String
  totalMatches     Int
  startedAt        DateTime
  endedAt          DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
}

model Juror {
  id                  String                    @id @default(cuid())
  name                String
  code                String                    @unique
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  deletedAt           DateTime?

  phaseAuthorizations PhaseJurorAuthorization[]
  scores              PresentationScore[]
  analyticScores      EvaluationCriteriaScore[]
}

model PhaseJurorAuthorization {
  id        String    @id @default(cuid())
  phaseId   String
  phase     Phase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  jurorId   String
  juror     Juror     @relation(fields: [jurorId], references: [id], onDelete: Cascade)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([phaseId, jurorId])
}


model EvaluationItem {
  id             String                @id @default(cuid())
  championship   String
  type           String
  mode           String                @default("aberta")
  text           String
  imageUrl       String?
  optionA        String?
  optionB        String?
  optionC        String?
  optionD        String?
  optionE        String?
  optionF        String?
  optionG        String?
  optionH        String?
  correctIndexes String?
  timeSeconds    Int?
  maxPoints      Int
  phase          Int
  scope          String                @default("single")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  jurorAssignments EvaluationItemJuror[]
  criteria         EvaluationCriteria[]
}
model EvaluationItemJuror {
  id        String         @id @default(cuid())
  itemId    String
  jurorId   String
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  item      EvaluationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, jurorId])
}

model EvaluationCriteria {
  id        String                    @id @default(cuid())
  itemId    String
  item      EvaluationItem            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label     String
  maxPoints Int
  order     Int                       @default(0)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  deletedAt DateTime?

  scores    EvaluationCriteriaScore[]
}

model EvaluationCriteriaScore {
  id         String             @id @default(cuid())
  criteriaId String
  criteria   EvaluationCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  jurorId    String
  juror      Juror              @relation(fields: [jurorId], references: [id], onDelete: Cascade)
  team       String
  score      Int
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?

  @@unique([criteriaId, jurorId, team])
}

model PresentationDocument {
  id        String    @id @default(cuid())
  phaseId   String
  duplaId   String
  teamId    String
  fileUrl   String
  fileName  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([duplaId, teamId])
}

model Moderator {
  id        String                    @id @default(cuid())
  name      String
  code      String                    @unique
  role      String                    @default("secundario")
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  deletedAt DateTime?

  areas     ModeratorAreaPermission[]
}

model ModeratorAreaPermission {
  id          String    @id @default(cuid())
  moderatorId String
  moderator   Moderator @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  area        String
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([moderatorId, area])
}

model AdminAuth {
  id           Int      @id @default(1)
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model AdminSession {
  token     String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
}